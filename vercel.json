{
  "version": 2,
  "buildCommand": "pnpm --filter ./artifacts/drugscope build",
  "outputDirectory": "artifacts/drugscope/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
