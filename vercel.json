{
  "version": 2,
  "buildCommand": "cd artifacts/drugscope && pnpm build",
  "outputDirectory": "artifacts/drugscope/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
